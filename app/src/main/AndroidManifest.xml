<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
 <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application android:theme="@style/AppTheme" android:label="MusabDosya Yöneticisi" android:icon="@drawable/ic_launcher" android:requestLegacyExternalStorage="true" android:usesCleartextTraffic="false">
  <activity android:name=".MusabTextActivity" android:exported="false"/>
  <activity android:name=".MusabXmlViewerActivity" android:exported="false"/>
  <activity android:name=".MusabImageViewerActivity" android:exported="false"/>
  <activity android:name=".MusabVideoViewerActivity" android:exported="false"/>
  <activity android:name=".MusabAudioPlayerActivity" android:exported="false"/>
  <activity android:name=".MusabArchiveViewerActivity" android:exported="false"/>
  <activity android:name=".Musab3DModelViewerActivity" android:exported="true" android:label="Musab 3D Model Görüntüleyici">
   <intent-filter>
    <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="content" android:mimeType="model/obj"/><data android:scheme="file" android:mimeType="model/obj"/>
    <data android:scheme="content" android:mimeType="model/stl"/><data android:scheme="file" android:mimeType="model/stl"/>
    <data android:scheme="content" android:mimeType="model/ply"/><data android:scheme="file" android:mimeType="model/ply"/>
   </intent-filter>
  </activity>
  <activity android:name=".MusabBuildActivity" android:exported="false"/>
  <activity android:name=".BinaryEditorPlusActivity" android:exported="false"/>
  <activity android:name=".DexEditorPlusActivity" android:exported="false" android:label="Dex Editör Plus"/>
  <activity android:name=".ArscEditorPlusActivity" android:exported="false" android:label="ARSC Editör Plus"/>
  <activity android:name=".SkkInstallerActivity" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <category android:name="android.intent.category.BROWSABLE"/>
    <data android:mimeType="application/x-skk"/>
    <data android:scheme="content" android:pathPattern=".*\\.skk"/>
    <data android:scheme="file" android:pathPattern=".*\\.skk"/>
   </intent-filter>
  </activity>
  <activity android:name=".FastMainActivity" android:screenOrientation="portrait" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <receiver android:name=".MusabWidgetProvider" android:exported="false">
   <intent-filter>
    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
    <action android:name="com.musab.dosyayoneticisi.WIDGET_TICK"/>
   </intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_musab_info"/>
  </receiver>
  <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
   <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths"/>
  </provider>
 </application>
</manifest>