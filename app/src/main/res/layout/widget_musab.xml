<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_cute" android:contentDescription="Musab" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Musab Dosya Yöneticisi" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dosyaların yanında ✦" android:textColor="#E9D7FF" android:textSize="13sp" android:paddingTop="3dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_face" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="✦" android:textColor="#FFFFFF" android:textSize="25sp" />
</LinearLayout>
